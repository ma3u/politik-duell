  "programme": [
    {
      "partei_id": 11,
      "land": null,
      "massnahmen": [
        {
          "beschreibung": "Keine Kennzeichnungspflicht für Bundespolizisten und keine Pflicht zur Kontrollquittung bei Kontrollen, um die Polizei von Bürokratie freizuhalten.",
          "ursachen_ids": [
            902
          ],
          "buendel": "Kontrollquittung",
          "zitat": "Die Einführung einer Kennzeichnungspflicht für Bundespolizisten lehnen wir ab. Wir verpflichten sie auch nicht, anlässlich einer Kontrolle eine Kontrollquittung auszustellen.",
          "seite": 40
        }
      ]
    },
    {
      "partei_id": 11,
      "land": "BE",
      "massnahmen": [
        {
          "beschreibung": "Berichts- und Dokumentationspflichten der Polizei stark zurückfahren und überarbeiten",
          "ursachen_ids": [
            902
          ],
          "buendel": "Bürokratieabbau bei der Polizei",
          "zitat": "Polizeiarbeit darf nicht durch überbordende Bürokratie ausgebremst werden. Die Berichts- und Dokumentationspflichten werden wir daher drastisch zurückfahren und überarbeiten.",
          "seite": 8
        }
      ]
    },
    {
      "partei_id": 11,
      "land": "MV",
      "massnahmen": [
        {
          "beschreibung": "Durch Technik, Automatisierung und KI den Zeitanteil bürokratischer Routineprozesse im Polizeidienst deutlich verringern, damit mehr Zeit für Prävention und Strafverfolgung bleibt.",
          "ursachen_ids": [
            902
          ],
          "buendel": "Bürokratieabbau bei der Polizei",
          "zitat": "Mit einer stets an die zeitgemäßen Erfordernisse angepassten technischen Ausstattung auf dem höchsten technischen Standard und durch den Einsatz technischer Automatisierung und Künstlicher Intelligenz werden wir den Zeitanteil bürokratischer Routineprozesse im Dienst deutlich verringern, damit Polizistinnen und Polizisten den Fokus auf Prävention und Strafverfolgung legen können.",
          "seite": 28
        }
      ]
    },
    {
