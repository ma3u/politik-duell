  "programme": [
    {
      "partei_id": 11,
      "land": null,
      "massnahmen": [],
      "keine_massnahme": "Nachtrag Lösungsweg Steuern auf Sprit: Fundstelle S. 36 gelesen (Agrardiesel-Rückvergütung, Befreiung alternativer Kraftstoffe in der Land- und Forstwirtschaft von der Energiesteuer, nur Branchenentlastung, keine Senkung für Autofahrende). Volltextsuche nach Energiesteuer, Kraftstoff, Benzin, Diesel, Spritpreis, Tankrabatt, Mineralöl ohne weitere Treffer; Stromsteuer (S. mit Zeilen 771, 874) betrifft Strom, nicht Sprit."
    },
    {
      "partei_id": 12,
      "land": null,
      "massnahmen": [],
      "keine_massnahme": "Nachtrag Spritsteuern: Kapitel 'Mobilität' (S. 35-37), CO2-Preis-Passage (S. 33-34) und Wortsuche (Kraftstoff, Benzin, Diesel, Sprit, Pendler, Entfernungspauschale, Dienstwagen, Subvention) gelesen; keine Zusage zur Senkung oder Anhebung von Steuern und Abgaben auf Kraftstoffe."
    },
    {
      "partei_id": 13,
      "land": null,
      "massnahmen": [],
      "keine_massnahme": "Nachtrag Ursache 1502: Volltextsuche nach Diesel, Energiesteuer, Kraftstoff, Subvention, Tanken, Spritpreis; Seite 40 gelesen. Keine Zusage zur Kraftstoffbesteuerung (weder Senkung noch Anhebung); nur allgemeiner Subventionsabbau und Reform des Dienstwagenprivilegs."
    },
    {
      "partei_id": 14,
      "land": null,
      "massnahmen": [],
      "keine_massnahme": "Nachtrag Lösungsweg Steuern/Abgaben auf Sprit: Fundstelle S. 17 (Kapitel Bezahlbare Energie) gelesen, sie ist bereits erfasst; weitere Stellen zu Energiesteuer, Kraftstoff, Sprit, Mineralöl im ganzen Text per Suche gesehen (S. 42 bereits erfasst, E-Fuels); keine weitere Zusage zu Kraftstoffsteuern."
    },
    {
      "partei_id": 15,
      "land": null,
      "massnahmen": [],
      "keine_massnahme": "Nachtrag Energiesteuer (Ursache 1502): Fundstelle S. 14 (bereits erfasst) und Kapitel Verkehr (S. 43-45) gelesen; Volltextsuche nach Energiesteuer, Mineralöl, Kraftstoff, Benzin, Diesel, Spritpreis: keine weitere Zusage zu Steuern auf Sprit. Die Gleichbehandlung synthetischer Kraftstoffe (S. 44) ist bereits erfasst."
    },
    {
      "partei_id": 16,
      "land": null,
      "massnahmen": [
        {
          "beschreibung": "Ablehnung des europäischen Emissionshandels für Wärme und Verkehr (ETS-2); stattdessen verbindliche Klimaziele und Emissionsgrenzen, damit kein CO₂-Preis auf Kraftstoffe entsteht.",
          "ursachen_ids": [
            1502
          ],
          "zitat": "Wir lehnen den Emissionshandel in den Sektoren Wärme und Verkehr (ETS-2) ab: Stattdessen müssen verbindliche Klimaziele und Emissionsgrenzen gesetzt werden.",
          "seite": 33
        }
      ]
    },
    {
      "partei_id": 17,
      "land": null,
      "massnahmen": [],
      "keine_massnahme": "Nachtrag Lösungsweg Steuern/Abgaben auf Sprit: Verkehrskapitel S. 28-29 und S. 10 gelesen, Grep nach Sprit, Benzin, Diesel, Kraftstoff, Energiesteuer, Mehrwertsteuer, Pendler. Nur die allgemeine Aussage 'preiswerte Kraftstoffe' (S. 29) ohne Steuerinstrument; keine Zusage zu Energiesteuer-Senkung oder -Erhöhung."
    }
