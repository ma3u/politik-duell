          ],
          "zitat": "Beantragung von Asyl und einem sonstigen Schutzstatus nur bei nachgewiesener Identität und Staatsangehörigkeit",
          "seite": 104
        },
        {
          "beschreibung": "Asylrecht entfällt bei Falschangaben zur Identität im Asylverfahren",
          "ursachen_ids": [
            604
          ],
          "zitat": "Wegfall des Asylrechts bei Falschangaben zur Identität im Asylverfahren",
          "seite": 105
        }
      ]
    },
    {
      "partei_id": 16,
      "land": null,
      "massnahmen": [],
      "keine_massnahme": "Nachtrag zu Lösungsweg ‚Identität und Hintergrund bei Einreise strenger prüfen' zu Ursache 604. Kapitel 17 ‚Für eine gerechte Einwanderungsgesellschaft, Asylrecht verteidigen' (S. 52–54) vollständig gelesen. Die Linke fordert sichere legale Einreisemöglichkeiten, Verbot rassistischer Polizeikontrollen, Visaliberalisierung und Abschaffung von Pushbacks – keine Maßnahme zu Identitätsprüfung oder Hintergrundprüfung bei Einreise."
    },
    {
      "partei_id": 17,
      "land": null,
      "massnahmen": [],
      "keine_massnahme": "Kapitel 'Sichere Grenzen' (S. 36–38) und Fundstellen S. 34 gelesen; keine Zusagen zu Identitätsprüfung oder Hintergrundchecks bei Einreise/Registrierung. Suchbegriffe (biometrisch, Fingerabdruck, EURODAC, Handydaten, ohne Papiere/Pass, Datenschutz für Geflüchtete) nicht gefunden.",
      "nicht_erfasst": [
        {
          "ursache": 604,
          "seiten": [
            34,
            36,
            37,
            38
          ],
          "grund": "Hit auf S. 34 ist nicht relevant (Geschlechtsidentitätswechsel). Migrationspolitik auf S. 36–38 behandelt Migration allgemein (Abschiebungen, Asylverfahren, Integration), aber nicht Identitätsprüfungen oder biometrische Datenerfassung bei Einreise/Registrierung."
        }
      ]
    }
